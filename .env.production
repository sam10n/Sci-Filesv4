# Paste your two Supabase values after the equals signs (no quotes, no spaces).
# This file is read when the site is built (Vercel, or `npm run build`), so it
# travels with the project and you don't need to set Vercel environment variables.
#
# Supabase dashboard > Project Settings > API:
#   Project URL       -> looks like https://abcdefgh.supabase.co
#   anon public key   -> long text starting with eyJ
#
# The anon key is designed to be public (it is shipped to every visitor's browser);
# your data is protected by the database rules in supabase_schema.sql, not by hiding this key.
# NEVER paste the "service_role" key here. If you put this project on GitHub, keep the repo Private.
VITE_SUPABASE_URL=https://hvfhawbddqqlyqlnaabn.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh2Zmhhd2JkZHFxbHlxbG5hYWJuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM1NzgxMzQsImV4cCI6MjEwOTE1NDEzNH0.Vj0GoLmH_KK_Zvp7zqU0gkdulSfchuZkFRcU4qn_OSE

# Leave false until you have switched on Google sign-in in Supabase (see README, section 5).
VITE_GOOGLE_LOGIN=false
